# ==============================================================================
# Relentless Environment Configuration Template
# Copy this file to `.env` for local runs, or paste these keys into Railway.
# Never commit your real `.env` file to version control!
# ==============================================================================

# 1. PostgreSQL Database (Required — free tier works on Neon.tech)
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"
# Optional Neon pooled URI for high concurrency:
DATABASE_URL_POOLER=""

# 2. System-1 AI Triage Model (Required — OpenRouter Decisions OR TypeSafe Direct)
OPENROUTER_API_KEY="sk-or-v1-..."
TYPESAFE_API_KEY=""

# 3. System-2 Resume Tailor & Form Agent (Recommended — OpenAI GPT-4o-mini)
OPENAI_API_KEY="sk-proj-..."

# 4. Web Command Center Security (Required for public/cloud hosting like Railway or Netlify)
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEB_API_KEY=""
# Optional separate HMAC signing key for login cookies (defaults to WEB_API_KEY):
WEB_SESSION_SECRET=""
# Optional CORS allow-origin (set to your Netlify site URL if hosting UI separately, else *):
WEB_CORS_ORIGIN="*"

# 5. Telegram HITL Control Bot & /logs Alerts (Optional for Web-only; Recommended)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# 6. Polling Cadence & Logging
POLL_INTERVAL_HOURS="1.0"
LOG_LEVEL="INFO"
# Set LOG_FORMAT="json" for pure JSON stdout streams:
LOG_FORMAT="human"

# 7. Optional Gmail Job Alert Scanner (Requires Gmail 2FA + 16-char App Password)
# GMAIL_ADDRESS="you@gmail.com"
# GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
