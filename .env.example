# 1. Free Serverless Postgres with pgvector (https://neon.tech)
DATABASE_URL="postgresql://user:password@ep-xyz.aws.neon.tech/neondb?sslmode=require"
# Optional: pooled DSN (Neon pooled host, same URL with -pooler in hostname)
DATABASE_URL_POOLER=""

# 2. System-1 Decision Model Key (https://openrouter.ai/settings/keys or https://console.typesafe.ai)
OPENROUTER_API_KEY="sk-or-v1-..."
TYPESAFE_API_KEY=""

# 3. System-2 Resume Tailor Key (Optional: uses Direct OpenAI if set, otherwise falls back to OpenRouter)
OPENAI_API_KEY="sk-proj-..."

# 4. Telegram Bot HITL (Run `python manage.py setup` to auto-detect TELEGRAM_CHAT_ID!)
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
TELEGRAM_CHAT_ID=""
POLL_INTERVAL_HOURS="4.0"